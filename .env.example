# Optional but recommended for production. Attach a Vercel Blob store to the
# project and Vercel injects BLOB_READ_WRITE_TOKEN automatically — you don't
# set it by hand. Locally, leave both unset and the app falls back to
# writing share images into /public/generated for dev/testing.
# BLOB_READ_WRITE_TOKEN=

# After creating the Blob store, copy its public base URL here so share pages
# can build the OG image URL without a database lookup, e.g.:
# NEXT_PUBLIC_BLOB_BASE_URL=https://xxxxxxxxxxxx.public.blob.vercel-storage.com

# Used for absolute OG URLs; Vercel deployments infer this from headers if unset.
# NEXT_PUBLIC_SITE_URL=https://your-domain.vercel.app
